# Server-side only. Never expose these values through NEXT_PUBLIC_* variables.
BINANCE_RELAY_URL=
BINANCE_RELAY_TOKEN=
FRED_API_KEY=
ARKHAM_API_KEY=
ARKHAM_API_URL=
# Optional Telegram companion. Disabled unless all values are configured server-side.
